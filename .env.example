# Copy to .env (git-ignored) and fill in. Never commit .env, never log these.

# Local vLLM on the L40S. vLLM listens on 127.0.0.1 only; reach it through the Tailscale Funnel HTTPS URL.
# URL and key are in the private chat. A wrong URL makes the run fall back to rules-only.
LLM_BASE_URL=https://<vm>.<tailnet>.ts.net/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.8-27B-FP8

# Fallback: Groq free tier (optional)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=

# Per-call timeout (s) and per-scenario call budget
LLM_TIMEOUT_S=8
LLM_CALL_BUDGET=87
