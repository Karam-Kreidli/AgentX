# Copy to .env (git-ignored) and fill in. Never commit .env, never log these.

# Local vLLM on the L40S (reach it over Tailscale; URL and key are in the private chat)
LLM_BASE_URL=http://<vm-tailscale-ip>:8000/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.8-27B-FP8

# Fallback: Groq free tier (optional)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=

# Per-call timeout (s) and per-scenario call budget
LLM_TIMEOUT_S=8
LLM_CALL_BUDGET=87
